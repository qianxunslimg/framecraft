[
  {
    "from": 308,
    "to": 356,
    "text": "早上十点问句话"
  },
  {
    "from": 356,
    "to": 437,
    "text": "这版今天能发吗"
  },
  {
    "from": 437,
    "to": 511,
    "text": "还没张口先叠甲"
  },
  {
    "from": 511,
    "to": 599,
    "text": "怕出问题实在怕"
  },
  {
    "from": 599,
    "to": 661,
    "text": "编译绿了别急夸"
  },
  {
    "from": 661,
    "to": 735,
    "text": "能跑一样也会炸"
  },
  {
    "from": 735,
    "to": 812,
    "text": "虽然日志正常呀"
  },
  {
    "from": 812,
    "to": 890,
    "text": "但是不能保证啦"
  },
  {
    "from": 890,
    "to": 971,
    "text": "通过不代表验收"
  },
  {
    "from": 971,
    "to": 1049,
    "text": "跑通不代表能走"
  },
  {
    "from": 1049,
    "to": 1113,
    "text": "测过不代表没漏"
  },
  {
    "from": 1113,
    "to": 1199,
    "text": "把边界全部说透"
  },
  {
    "from": 1199,
    "to": 1265,
    "text": "不是这个而是那呀"
  },
  {
    "from": 1265,
    "to": 1351,
    "text": "不能这样不代表啦"
  },
  {
    "from": 1351,
    "to": 1421,
    "text": "每句话都叠三层甲"
  },
  {
    "from": 1421,
    "to": 1502,
    "text": "虽然但是绕圈说呀"
  },
  {
    "from": 1502,
    "to": 1569,
    "text": "结论藏进括号里啦"
  },
  {
    "from": 1569,
    "to": 1651,
    "text": "免责声明摞成高塔"
  },
  {
    "from": 1651,
    "to": 1735,
    "text": "我就想问行不行"
  },
  {
    "from": 1735,
    "to": 1875,
    "text": "未核实，不应假定！"
  },
  {
    "from": 2431,
    "to": 2478,
    "text": "下午改动本来少"
  },
  {
    "from": 2478,
    "to": 2556,
    "text": "它嫌护栏不够牢"
  },
  {
    "from": 2556,
    "to": 2631,
    "text": "判空校验全出招"
  },
  {
    "from": 2631,
    "to": 2707,
    "text": "异常捕获层层套"
  },
  {
    "from": 2707,
    "to": 2788,
    "text": "三行需求写到爆"
  },
  {
    "from": 2788,
    "to": 2860,
    "text": "边界测试垒得高"
  },
  {
    "from": 2860,
    "to": 2937,
    "text": "跑完绿灯满屏飘"
  },
  {
    "from": 2937,
    "to": 3013,
    "text": "冷静发来新警告"
  },
  {
    "from": 3013,
    "to": 3089,
    "text": "模拟绿得像长城"
  },
  {
    "from": 3089,
    "to": 3166,
    "text": "不代表实车能成"
  },
  {
    "from": 3166,
    "to": 3241,
    "text": "未测分支怕有坑"
  },
  {
    "from": 3241,
    "to": 3388,
    "text": "最后还得——我硬撑！"
  },
  {
    "from": 3388,
    "to": 3470,
    "text": "不是这个而是那呀"
  },
  {
    "from": 3470,
    "to": 3548,
    "text": "不能这样不代表啦"
  },
  {
    "from": 3548,
    "to": 3620,
    "text": "每句话都叠三层甲"
  },
  {
    "from": 3620,
    "to": 3700,
    "text": "虽然但是绕圈说呀"
  },
  {
    "from": 3700,
    "to": 3764,
    "text": "结论藏进括号里啦"
  },
  {
    "from": 3764,
    "to": 3843,
    "text": "免责声明摞成高塔"
  },
  {
    "from": 3843,
    "to": 3920,
    "text": "我就想问行不行"
  },
  {
    "from": 3920,
    "to": 4078,
    "text": "未核实，不应假定！"
  },
  {
    "from": 4078,
    "to": 4144,
    "text": "这首歌儿唱完啦"
  },
  {
    "from": 4144,
    "to": 4224,
    "text": "不代表能下班呀"
  },
  {
    "from": 4224,
    "to": 4304,
    "text": "虽然绿灯亮着啦"
  },
  {
    "from": 4304,
    "to": 4440,
    "text": "上线前，请再查查～"
  }
]
