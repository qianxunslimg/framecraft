    {
      "id": "intro",
      "badge": "01 · 什么是 MySQL？",
      "title": "它是干啥的？为什么几乎每个 App 都用它？",
      "theme": "sky",
      "from": 0,
      "duration": 2555,
      "cues": [
        {
          "cue": "whatIsMysql",
          "from": 12,
          "duration": 655,
          "display": "MySQL = 全球最流行的开源关系型数据库 · 互联网系统的核心“超级电子账本”！",
          "highlight": "关系型数据库"
        },
        {
          "cue": "whyNotExcel",
          "from": 676,
          "duration": 1111,
          "display": "为什么不用 Excel/文件？MySQL = 扛高并发不撞车 · 千万数据毫秒查 · 事务严谨不丢账！",
          "highlight": "毫秒级秒查"
        },
        {
          "cue": "realScenarios",
          "from": 1796,
          "duration": 741,
          "display": "核心位置：App/网页 → 后端服务 → MySQL（电商订单 · 支付账务 · 账号权限 · 企业后台）",
          "highlight": "核心业务数据"
        }
      ]
    },
    {
      "id": "architecture",
      "badge": "02 · 一条 SQL 的内部旅程",
      "title": "MySQL Server 层与存储引擎层",
      "theme": "night",
      "from": 2555,
      "duration": 2042,
      "cues": [
        {
          "cue": "sqlFlow",
          "from": 14,
          "duration": 604,
          "display": "MySQL 两大分层：Server 层（动脑分析优化） + 插件式存储引擎层（落地存数据）",
          "highlight": "Server 层"
        },
        {
          "cue": "fourSteps",
          "from": 627,
          "duration": 794,
          "display": "流水线：连接器（鉴权/连接池）→ 解析器（语法）→ 优化器（挑索引）→ 执行器",
          "highlight": "优化器"
        },
        {
          "cue": "noQueryCache",
          "from": 1430,
          "duration": 594,
          "display": "注意：MySQL 8.0 已彻底移除查询缓存（Query Cache），别被老教程带偏！",
          "highlight": "MySQL 8.0"
        }
      ]
    },
    {
      "id": "engines",
      "badge": "03 · 存储引擎核心对决",
      "title": "为什么核心业务几乎清一色选 InnoDB？",
      "theme": "sky",
      "from": 4597,
      "duration": 1956,
      "cues": [
        {
          "cue": "pluggable",
          "from": 14,
          "duration": 471,
          "display": "插件式存储引擎：表级别可插拔，常见主力是 InnoDB、老引擎 MyISAM 与 Memory",
          "highlight": "插件式"
        },
        {
          "cue": "innodbVsMyisam",
          "from": 494,
          "duration": 942,
          "display": "InnoDB（事务 + 行级锁 + 崩溃恢复）完胜 MyISAM（无事务 + 仅表锁）！",
          "highlight": "InnoDB"
        },
        {
          "cue": "engineTakeaway",
          "from": 1445,
          "duration": 493,
          "display": "实战选型铁律：现代线上核心业务，认准默认主力 InnoDB！",
          "highlight": "无脑认准 InnoDB"
        }
      ]
    },
    {
      "id": "btreeIndex",
      "badge": "04 · 千万行秒查的秘密",
      "title": "B+Tree 索引 · 回表 · 覆盖索引 · 最左前缀",
      "theme": "arcade",
      "from": 6553,
      "duration": 3797,
      "cues": [
        {
          "cue": "whyBtree",
          "from": 14,
          "duration": 981,
          "display": "矮胖三层 B+Tree（16KB 页）：非叶子只存指针，约 2000 万条仅需 2～3 次 I/O！",
          "highlight": "两三次磁盘 I/O"
        },
        {
          "cue": "leafList",
          "from": 1004,
          "duration": 756,
          "display": "叶子节点双向链表：定位起点一路横扫，范围查询与排序完胜 Hash 索引！",
          "highlight": "双向链表"
        },
        {
          "cue": "clusterCover",
          "from": 1769,
          "duration": 1086,
          "display": "聚簇索引存整行 · 二级索引存主键 ID（再查主键叫回表；免回表叫覆盖索引！）",
          "highlight": "回表"
        },
        {
          "cue": "leftmostTrap",
          "from": 2864,
          "duration": 915,
          "display": "避坑：守住最左前缀！索引列套函数、前导百分号、隐式类型转换都会导致索引失效！",
          "highlight": "最左前缀原则"
        }
      ]
    },
    {
      "id": "transactions",
      "badge": "05 · 转账断电为何不丢钱？",
      "title": "事务与 ACID 四大铁律",
      "theme": "amber",
      "from": 10350,
      "duration": 1993,
      "cues": [
        {
          "cue": "transferCase",
          "from": 14,
          "duration": 592,
          "display": "经典场景：转账 = 扣 500 + 加 500，捆绑为一个事务，中途断电绝不能只成一半！",
          "highlight": "事务"
        },
        {
          "cue": "acidPillars",
          "from": 615,
          "duration": 702,
          "display": "A 原子性（靠 Undo Log 回滚） · D 持久性（靠 Redo Log 防断电丢数）",
          "highlight": "ACID"
        },
        {
          "cue": "acidIC",
          "from": 1326,
          "duration": 649,
          "display": "I 隔离性（靠锁 + MVCC） · C 一致性（A/I/D 共同守护的数据守恒目标）",
          "highlight": "隔离性"
        }
      ]
    },
    {
      "id": "mvcc",
      "badge": "06 · 并发读写不打架的魔术",
      "title": "并发三怪事 · 隔离级别 · MVCC 快照读",
      "theme": "mint",
      "from": 12343,
      "duration": 3712,
      "cues": [
        {
          "cue": "threeAnomalies",
          "from": 14,
          "duration": 946,
          "display": "并发三怪事：脏读（读未提交假数） · 不可重复读（同条变值） · 幻读（范围多新行）",
          "highlight": "三大怪事"
        },
        {
          "cue": "isolationLevels",
          "from": 969,
          "duration": 911,
          "display": "四大隔离级别：读未提交 → 读已提交(RC) → 可重复读(RR · InnoDB默认) → 串行化",
          "highlight": "可重复读"
        },
        {
          "cue": "mvccMagic",
          "from": 1889,
          "duration": 783,
          "display": "MVCC 读写不阻塞：每行背后藏有事务号 + Undo Log 历史版本链（类似 Git 历史）！",
          "highlight": "MVCC"
        },
        {
          "cue": "readViewDiff",
          "from": 2681,
          "duration": 1013,
          "display": "点破本质：读已提交 = 每次查拍新 Read View · 可重复读 = 整事务复用同一张！",
          "highlight": "Read View"
        }
      ]
    },
    {
      "id": "locks",
      "badge": "07 · 抢购防超卖与防死锁",
      "title": "表锁 · 行锁 · 间隙锁 · 线上锁表惨案",
      "theme": "rose",
      "from": 16055,
      "duration": 3266,
      "cues": [
        {
          "cue": "lockOverview",
          "from": 14,
          "duration": 987,
          "display": "写写并发靠锁排队：InnoDB 精细行级锁 · 共享锁(S 读共享) vs 排他锁(X 写独占)",
          "highlight": "行级锁"
        },
        {
          "cue": "rowLockTypes",
          "from": 1010,
          "duration": 957,
          "display": "InnoDB 行锁三面孔：Record Lock（锁行）· Gap Lock（锁空隙防幻读）· Next-Key Lock",
          "highlight": "Gap Lock 间隙锁"
        },
        {
          "cue": "lockTraps",
          "from": 1976,
          "duration": 1272,
          "display": "两大线上血坑：① WHERE 没走索引等效锁整表！ ② 死锁 → 统一固定顺序加锁 + 短事务！",
          "highlight": "加在索引上的"
        }
      ]
    },
    {
      "id": "logsBuffer",
      "badge": "08 · 缓冲池与三大核心日志",
      "title": "Buffer Pool · Redo · Undo · Binlog · 两阶段提交",
      "theme": "lavender",
      "from": 19321,
      "duration": 3423,
      "cues": [
        {
          "cue": "bufferWal",
          "from": 14,
          "duration": 1220,
          "display": "快且不丢的秘密：Buffer Pool 改内存页 + WAL 顺序追加 Redo Log（断电可恢复）！",
          "highlight": "Buffer Pool"
        },
        {
          "cue": "threeLogs",
          "from": 1243,
          "duration": 1219,
          "display": "三大日志彻底分清：Redo（防崩溃持久）· Undo（回滚+MVCC）· Binlog（主从复制/恢复）",
          "highlight": "三大日志"
        },
        {
          "cue": "twoPhaseCommit",
          "from": 2471,
          "duration": 934,
          "display": "两阶段提交：Redo(Prepare) → 写 Binlog → Redo(Commit)，主从与崩溃恢复零分裂！",
          "highlight": "两阶段提交"
        }
      ]
    },
    {
      "id": "finale",
      "badge": "09 · 一图打通全貌 · 准点下班",
      "title": "MySQL 底层原理全景架构与避坑清单",
      "theme": "cream",
      "from": 22744,
      "duration": 1888,
      "cues": [
        {
          "cue": "panorama",
          "from": 14,
          "duration": 1018,
          "display": "Server层(优化/Binlog) + InnoDB(B+Tree/BufferPool/MVCC/行锁/Redo+Undo) 全打通！",
          "highlight": "全景图"
        },
        {
          "cue": "quote",
          "from": 1041,
          "duration": 422,
          "display": "守最左前缀 · 更新必走索引 · 读写靠 MVCC / 写写靠行锁 · 短事务固定顺序防死锁",
          "highlight": "更新必走索引"
        },
        {
          "cue": "signoff",
          "from": 1472,
          "duration": 378,
          "display": "点赞收藏随时复盘，愿数据库零慢查零死锁，小牛马准点下班！",
          "highlight": "零慢查、零死锁"
        }
      ]
    }
  ],
  "captions": [
    {
      "from": 12,
      "duration": 187,
      "text": "每天点外卖下单、微信给好友转账、逛电商查历史订单、打游戏存装备，",
      "highlight": ""
    },
    {
      "from": 199,
      "duration": 146,
      "text": "这些每天成亿次更新的账号、余额和订单到底存在哪里？",
      "highlight": ""
    },
    {
      "from": 351,
      "duration": 120,
      "text": "答案十有八九，就是全球最流行的开源关系型数据库，",
      "highlight": "关系型数据库"
    },
    {
      "from": 471,
      "duration": 30,
      "text": "MySQL！",
      "highlight": ""
    },
    {
      "from": 507,
      "duration": 160,
      "text": "你可以把它理解成一座永不掉线、数据严丝合缝的超级电子账本。",
      "highlight": ""
    },
    {
      "from": 676,
      "duration": 65,
      "text": "既然都是按一张张表格存数据，",
      "highlight": ""
    },
    {
      "from": 741,
      "duration": 112,
      "text": "那为什么不直接用 Excel 表格或者本地文件，",
      "highlight": ""
    },
    {
      "from": 853,
      "duration": 66,
      "text": "非要专门装一个 MySQL？",
      "highlight": ""
    },
    {
      "from": 925,
      "duration": 51,
      "text": "原因有三点：第一，",
      "highlight": ""
    },
    {
      "from": 976,
      "duration": 125,
      "text": "几千人同时下单改同一份文件直接就撞车损坏了，",
      "highlight": ""
    },
    {
      "from": 1101,
      "duration": 142,
      "text": "而 MySQL 天生支持成千上万并发读写井然有序；",
      "highlight": ""
    },
    {
      "from": 1243,
      "duration": 125,
      "text": "第二，Excel 塞几十万条记录就卡死转圈，",
      "highlight": ""
    },
    {
      "from": 1368,
      "duration": 142,
      "text": "MySQL 在几千万条数据里照样毫秒级秒查；第三，",
      "highlight": "毫秒级秒查"
    },
    {
      "from": 1510,
      "duration": 170,
      "text": "MySQL 用表和表之间的严谨关系把用户、商品、订单串起来，",
      "highlight": ""
    },
    {
      "from": 1680,
      "duration": 107,
      "text": "还能靠事务保证转账扣款绝不丢钱不错账！",
      "highlight": ""
    },
    {
      "from": 1796,
      "duration": 54,
      "text": "在真实互联网架构里，",
      "highlight": ""
    },
    {
      "from": 1850,
      "duration": 92,
      "text": "你的手机和网页请求先打到后端程序，",
      "highlight": ""
    },
    {
      "from": 1942,
      "duration": 179,
      "text": "后端程序再用 SQL 语言去跟大后方的 MySQL 存取核心数据。",
      "highlight": ""
    },
    {
      "from": 2127,
      "duration": 129,
      "text": "从电商订单与库存、支付金融账务、用户账号权限，",
      "highlight": ""
    },
    {
      "from": 2256,
      "duration": 79,
      "text": "到企业的财务和后台管理系统，",
      "highlight": ""
    },
    {
      "from": 2335,
      "duration": 118,
      "text": "凡是结构规整、绝不允许出错的核心业务数据，",
      "highlight": "核心业务数据"
    },
    {
      "from": 2453,
      "duration": 84,
      "text": "几乎都稳稳托付给 MySQL。",
      "highlight": ""
    },
    {
      "from": 2569,
      "duration": 80,
      "text": "搞清楚 MySQL 是干啥的之后，",
      "highlight": ""
    },
    {
      "from": 2649,
      "duration": 52,
      "text": "我们直接钻进它的内部，",
      "highlight": ""
    },
    {
      "from": 2701,
      "duration": 85,
      "text": "看看平时发出去的一条 SQL 语句，",
      "highlight": ""
    },
    {
      "from": 2786,
      "duration": 52,
      "text": "到底在里面经历了什么！",
      "highlight": ""
    },
    {
      "from": 2844,
      "duration": 98,
      "text": "其实 MySQL 整体分成上下两大块：",
      "highlight": ""
    },
    {
      "from": 2942,
      "duration": 118,
      "text": "上面叫 Server 层，是负责动脑子的大脑；",
      "highlight": "Server 层"
    },
    {
      "from": 3060,
      "duration": 113,
      "text": "下面叫存储引擎层，是真正负责读写磁盘的手脚。",
      "highlight": ""
    },
    {
      "from": 3182,
      "duration": 120,
      "text": "一条查询进来，先经过连接器验证账号权限，",
      "highlight": ""
    },
    {
      "from": 3302,
      "duration": 96,
      "text": "所以线上一定要用连接池复用连接。",
      "highlight": ""
    },
    {
      "from": 3404,
      "duration": 146,
      "text": "接着解析器检查你的 SQL 语法有没有写错、表名是否存在。",
      "highlight": ""
    },
    {
      "from": 3556,
      "duration": 133,
      "text": "最关键的是第三步优化器：一张表往往有好几个索引，",
      "highlight": "优化器"
    },
    {
      "from": 3689,
      "duration": 127,
      "text": "优化器会自动算成本，挑出最省力的一条查询路线，",
      "highlight": "优化器"
    },
    {
      "from": 3816,
      "duration": 99,
      "text": "平时用 EXPLAIN 看执行计划，",
      "highlight": ""
    },
    {
      "from": 3915,
      "duration": 61,
      "text": "看的正是优化器的决定！",
      "highlight": "优化器"
    },
    {
      "from": 3985,
      "duration": 113,
      "text": "最后由执行器调用底层存储引擎的接口，",
      "highlight": ""
    },
    {
      "from": 4098,
      "duration": 81,
      "text": "真正把数据取出来返回给你。",
      "highlight": ""
    },
    {
      "from": 4185,
      "duration": 135,
      "text": "顺带提醒一个新版细节：很多老资料还在讲查询缓存，",
      "highlight": ""
    },
    {
      "from": 4320,
      "duration": 113,
      "text": "但因为表一更新缓存就整片失效、收益太低，",
      "highlight": ""
    },
    {
      "from": 4433,
      "duration": 146,
      "text": "从 MySQL 8.0 开始已经彻底移除查询缓存了。",
      "highlight": "MySQL 8.0"
    },
    {
      "from": 4611,
      "duration": 107,
      "text": "为什么 MySQL 要把存储引擎单独拆出来？",
      "highlight": ""
    },
    {
      "from": 4724,
      "duration": 95,
      "text": "因为不同业务对数据的要求完全不同，",
      "highlight": ""
    },
    {
      "from": 4819,
      "duration": 84,
      "text": "MySQL 把引擎做成插件式，",
      "highlight": "插件式"
    },
    {
      "from": 4903,
      "duration": 106,
      "text": "同一座库里不同表甚至可以换装不同引擎，",
      "highlight": ""
    },
    {
      "from": 5009,
      "duration": 73,
      "text": "就像给车换发动机一样灵活。",
      "highlight": ""
    },
    {
      "from": 5091,
      "duration": 145,
      "text": "实战中最经典的就是 InnoDB 和早年的 MyISAM 对比。",
      "highlight": "InnoDB"
    },
    {
      "from": 5242,
      "duration": 145,
      "text": "MyISAM 不支持事务，改到一半宕机数据容易坏，",
      "highlight": ""
    },
    {
      "from": 5387,
      "duration": 127,
      "text": "而且它只有表级锁，只要有一个人在改某条记录，",
      "highlight": ""
    },
    {
      "from": 5514,
      "duration": 116,
      "text": "整张表直接锁死，别人连别的订单都改不了！",
      "highlight": ""
    },
    {
      "from": 5636,
      "duration": 165,
      "text": "而 InnoDB 从 MySQL 5.5 起就成了绝对默认主力：",
      "highlight": "InnoDB"
    },
    {
      "from": 5801,
      "duration": 155,
      "text": "支持完整的事务、支持精细的行级锁、还支持崩溃后自动安全恢复，",
      "highlight": ""
    },
    {
      "from": 5956,
      "duration": 77,
      "text": "高并发改不同记录完全互不打架。",
      "highlight": ""
    },
    {
      "from": 6042,
      "duration": 159,
      "text": "除此之外还有把数据全放内存、重启就清空的 Memory 引擎，",
      "highlight": ""
    },
    {
      "from": 6201,
      "duration": 72,
      "text": "偶尔用来存极小的临时计算表。",
      "highlight": ""
    },
    {
      "from": 6279,
      "duration": 92,
      "text": "一句话记住选型结论：如今线上业务表，",
      "highlight": ""
    },
    {
      "from": 6371,
      "duration": 72,
      "text": "除非有极特殊的历史遗留需求，",
      "highlight": ""
    },
    {
      "from": 6443,
      "duration": 92,
      "text": "否则无脑认准 InnoDB 就对了！",
      "highlight": "无脑认准 InnoDB"
    },
    {
      "from": 6567,
      "duration": 143,
      "text": "同样是一张两千万条的订单表，没加索引查一条要好几秒，",
      "highlight": ""
    },
    {
      "from": 6710,
      "duration": 77,
      "text": "加了索引只要几毫秒，凭什么？",
      "highlight": ""
    },
    {
      "from": 6793,
      "duration": 86,
      "text": "核心全在 InnoDB 的 B+Tree 索引！",
      "highlight": ""
    },
    {
      "from": 6885,
      "duration": 140,
      "text": "InnoDB 读写磁盘按 16KB 为一页来搬运，",
      "highlight": ""
    },
    {
      "from": 7025,
      "duration": 129,
      "text": "B+Tree 的非叶子节点只存索引值和页指针，",
      "highlight": ""
    },
    {
      "from": 7154,
      "duration": 107,
      "text": "不存整条数据，一页就能塞下上千个分支。",
      "highlight": ""
    },
    {
      "from": 7267,
      "duration": 162,
      "text": "所以一棵矮胖的三层 B+Tree 就能装下大约两千万条数据，",
      "highlight": ""
    },
    {
      "from": 7429,
      "duration": 119,
      "text": "找任何一条记录最多只需要两三次磁盘 I/O！",
      "highlight": "两三次磁盘 I/O"
    },
    {
      "from": 7557,
      "duration": 163,
      "text": "而且 B+Tree 把所有真实数据都整齐排在最底层叶子节点，",
      "highlight": ""
    },
    {
      "from": 7720,
      "duration": 82,
      "text": "还用双向链表把叶子首尾连起来。",
      "highlight": "双向链表"
    },
    {
      "from": 7808,
      "duration": 100,
      "text": "平时查最近七天的订单或者排序分页，",
      "highlight": ""
    },
    {
      "from": 7908,
      "duration": 101,
      "text": "定位到起点后顺着链表一路横扫就行！",
      "highlight": ""
    },
    {
      "from": 8015,
      "duration": 165,
      "text": "这也是 MySQL 为什么默认用 B+Tree 而不用 Hash 索引，",
      "highlight": ""
    },
    {
      "from": 8180,
      "duration": 73,
      "text": "因为 Hash 只能精确等值查，",
      "highlight": ""
    },
    {
      "from": 8253,
      "duration": 60,
      "text": "根本干不了范围查询和排序。",
      "highlight": ""
    },
    {
      "from": 8322,
      "duration": 64,
      "text": "理解 InnoDB 索引，",
      "highlight": ""
    },
    {
      "from": 8386,
      "duration": 69,
      "text": "还要分清聚簇索引和二级索引。",
      "highlight": ""
    },
    {
      "from": 8461,
      "duration": 67,
      "text": "按主键建的叫聚簇索引，",
      "highlight": ""
    },
    {
      "from": 8528,
      "duration": 104,
      "text": "它的叶子节点直接挂着整条完整数据；",
      "highlight": ""
    },
    {
      "from": 8632,
      "duration": 122,
      "text": "按手机号或订单号建的普通索引叫二级索引，",
      "highlight": ""
    },
    {
      "from": 8754,
      "duration": 122,
      "text": "叶子节点里只存索引列和对应的主键 id。",
      "highlight": ""
    },
    {
      "from": 8882,
      "duration": 75,
      "text": "所以按手机号查订单详情时，",
      "highlight": ""
    },
    {
      "from": 8957,
      "duration": 121,
      "text": "MySQL 会先查手机号树拿到主键 id，",
      "highlight": ""
    },
    {
      "from": 9078,
      "duration": 92,
      "text": "再回主键树查整条数据，这叫回表！",
      "highlight": "回表"
    },
    {
      "from": 9176,
      "duration": 122,
      "text": "如果你只查主键和手机号，二级索引里已经齐了，",
      "highlight": ""
    },
    {
      "from": 9298,
      "duration": 110,
      "text": "根本不用回表，这就叫性能极高的覆盖索引。",
      "highlight": "回表"
    },
    {
      "from": 9417,
      "duration": 119,
      "text": "实战调优再牢记联合索引的最左前缀原则：",
      "highlight": "最左前缀原则"
    },
    {
      "from": 9536,
      "duration": 112,
      "text": "比如建了城市、年龄、姓名的联合索引，",
      "highlight": ""
    },
    {
      "from": 9648,
      "duration": 75,
      "text": "就像查字典先看姓再看名，",
      "highlight": ""
    },
    {
      "from": 9723,
      "duration": 162,
      "text": "查询条件必须从最左边的城市用起；跳过城市直接查年龄，",
      "highlight": ""
    },
    {
      "from": 9885,
      "duration": 44,
      "text": "索引直接失效！",
      "highlight": ""
    },
    {
      "from": 9935,
      "duration": 19,
      "text": "另外，",
      "highlight": ""
    },
    {
      "from": 9954,
      "duration": 269,
      "text": "给索引列套函数或做算术运算、模糊查询以百分号开头、或者字符串字段传数字引发隐式转换，",
      "highlight": ""
    },
    {
      "from": 10223,
      "duration": 109,
      "text": "都会让索引当场失效退化成全表扫描。",
      "highlight": ""
    },
    {
      "from": 10364,
      "duration": 154,
      "text": "写业务最怕半途出事故：比如小牛马给朋友转账五百块，",
      "highlight": ""
    },
    {
      "from": 10518,
      "duration": 129,
      "text": "数据库要先给小牛马扣五百，再给朋友加五百。",
      "highlight": ""
    },
    {
      "from": 10653,
      "duration": 80,
      "text": "万一刚扣完钱机房突然断电，",
      "highlight": ""
    },
    {
      "from": 10733,
      "duration": 92,
      "text": "绝不能变成钱扣了但对方没收到！",
      "highlight": ""
    },
    {
      "from": 10831,
      "duration": 125,
      "text": "把多条操作捆成一个不可分割的整体，这就是事务。",
      "highlight": "事务"
    },
    {
      "from": 10965,
      "duration": 110,
      "text": "好事务必须守住著名的 ACID 四大特性，",
      "highlight": "ACID"
    },
    {
      "from": 11075,
      "duration": 120,
      "text": "而且每一条背后都有实打实的底层机制撑腰：第一，",
      "highlight": ""
    },
    {
      "from": 11195,
      "duration": 120,
      "text": "A 是原子性，要么全部成功，要么全部撤回原样，",
      "highlight": ""
    },
    {
      "from": 11315,
      "duration": 110,
      "text": "靠 Undo Log 回滚日志兜底；第二，",
      "highlight": ""
    },
    {
      "from": 11425,
      "duration": 73,
      "text": "D 是持久性，一旦点击提交，",
      "highlight": ""
    },
    {
      "from": 11498,
      "duration": 73,
      "text": "就算立刻断电数据也永久生效，",
      "highlight": ""
    },
    {
      "from": 11571,
      "duration": 96,
      "text": "靠 Redo Log 重做日志兜底；",
      "highlight": ""
    },
    {
      "from": 11676,
      "duration": 147,
      "text": "第三，I 是隔离性，几十个人同时转账互相不串台，",
      "highlight": "隔离性"
    },
    {
      "from": 11823,
      "duration": 159,
      "text": "靠锁机制和 MVCC 联手守护；第四，C 是一致性，",
      "highlight": ""
    },
    {
      "from": 11982,
      "duration": 86,
      "text": "转账前后两人总金额永远守恒，",
      "highlight": ""
    },
    {
      "from": 12068,
      "duration": 121,
      "text": "这是前面三个特性共同保障的最终业务目标。",
      "highlight": ""
    },
    {
      "from": 12195,
      "duration": 130,
      "text": "把谁实现谁记清楚，事务的底层逻辑瞬间就通了！",
      "highlight": ""
    },
    {
      "from": 12357,
      "duration": 114,
      "text": "一旦高并发下多个事务同时读写同一张表，",
      "highlight": ""
    },
    {
      "from": 12471,
      "duration": 108,
      "text": "不管控就会闹出三大怪事：第一叫脏读，",
      "highlight": "三大怪事"
    },
    {
      "from": 12579,
      "duration": 114,
      "text": "你读到了别人刚改完、但还没提交的数据，",
      "highlight": ""
    },
    {
      "from": 12693,
      "duration": 157,
      "text": "结果对方随后回滚，你拿了个假余额；第二叫不可重复读，",
      "highlight": ""
    },
    {
      "from": 12850,
      "duration": 157,
      "text": "你在同一个对账事务里查两次余额，中间被别人改并提交，",
      "highlight": ""
    },
    {
      "from": 13007,
      "duration": 96,
      "text": "两次结果居然对不上；第三叫幻读，",
      "highlight": ""
    },
    {
      "from": 13103,
      "duration": 66,
      "text": "你按范围查订单有五条，",
      "highlight": ""
    },
    {
      "from": 13169,
      "duration": 134,
      "text": "一秒后再查突然多出一条别人刚插进来的新订单。",
      "highlight": ""
    },
    {
      "from": 13312,
      "duration": 148,
      "text": "为了在安全和性能之间取舍，数据库设计了四个隔离级别：",
      "highlight": ""
    },
    {
      "from": 13460,
      "duration": 148,
      "text": "最松的读未提交啥都防不住；第二档读已提交能防住脏读，",
      "highlight": ""
    },
    {
      "from": 13608,
      "duration": 57,
      "text": "很多数据库默认用它；",
      "highlight": ""
    },
    {
      "from": 13665,
      "duration": 108,
      "text": "第三档可重复读能防住脏读和不可重复读，",
      "highlight": "可重复读"
    },
    {
      "from": 13773,
      "duration": 137,
      "text": "正是 MySQL InnoDB 的默认隔离级别，",
      "highlight": ""
    },
    {
      "from": 13910,
      "duration": 148,
      "text": "并且 InnoDB 还会额外配合间隙锁大幅防住幻读；",
      "highlight": ""
    },
    {
      "from": 14058,
      "duration": 125,
      "text": "最高档串行化则是读写全排队，最稳但并发太慢，",
      "highlight": ""
    },
    {
      "from": 14183,
      "duration": 40,
      "text": "线上极少使用。",
      "highlight": ""
    },
    {
      "from": 14232,
      "duration": 113,
      "text": "你肯定好奇：为什么财务正在导大对账单，",
      "highlight": ""
    },
    {
      "from": 14345,
      "duration": 131,
      "text": "前台顾客同时在狂改订单，两边竟然不互相卡死？",
      "highlight": ""
    },
    {
      "from": 14482,
      "duration": 117,
      "text": "秘密就是 InnoDB 的王牌黑科技 MVCC，",
      "highlight": "MVCC"
    },
    {
      "from": 14599,
      "duration": 39,
      "text": "多版本并发控制！",
      "highlight": ""
    },
    {
      "from": 14644,
      "duration": 160,
      "text": "InnoDB 会在每条数据背后藏下最近修改它的事务号和回滚指针，",
      "highlight": ""
    },
    {
      "from": 14804,
      "duration": 155,
      "text": "把每次修改前的旧数据用 Undo Log 串成一条历史版本链，",
      "highlight": ""
    },
    {
      "from": 14959,
      "duration": 56,
      "text": "就像代码提交记录一样。",
      "highlight": ""
    },
    {
      "from": 15024,
      "duration": 44,
      "text": "当你发起普通查询时，",
      "highlight": ""
    },
    {
      "from": 15068,
      "duration": 131,
      "text": "InnoDB 会拍一张叫做 Read View 的快照名单，",
      "highlight": "Read View"
    },
    {
      "from": 15199,
      "duration": 56,
      "text": "记录此刻哪些事务还没提交。",
      "highlight": ""
    },
    {
      "from": 15261,
      "duration": 128,
      "text": "读到正在被别人修改的新版本时，它根本不傻等锁，",
      "highlight": ""
    },
    {
      "from": 15389,
      "duration": 129,
      "text": "而是直接顺着版本链往回找上一个已提交的老版本！",
      "highlight": ""
    },
    {
      "from": 15524,
      "duration": 83,
      "text": "顺便一招彻底分清两个常用级别：",
      "highlight": ""
    },
    {
      "from": 15607,
      "duration": 143,
      "text": "读已提交是每次查询都重拍一张新 Read View，",
      "highlight": "Read View"
    },
    {
      "from": 15750,
      "duration": 83,
      "text": "所以能看见别人最新提交的改动；",
      "highlight": ""
    },
    {
      "from": 15833,
      "duration": 121,
      "text": "而可重复读在整个事务期间只拍一次并反复复用，",
      "highlight": ""
    },
    {
      "from": 15954,
      "duration": 83,
      "text": "所以前后怎么查结果都纹丝不动！",
      "highlight": ""
    },
    {
      "from": 16069,
      "duration": 112,
      "text": "MVCC 完美解决了读与写不打架的问题，",
      "highlight": ""
    },
    {
      "from": 16181,
      "duration": 100,
      "text": "但如果两个顾客同时抢购最后一件商品，",
      "highlight": ""
    },
    {
      "from": 16281,
      "duration": 123,
      "text": "两个写操作同时去扣库存，就必须靠锁来排好队！",
      "highlight": ""
    },
    {
      "from": 16410,
      "duration": 37,
      "text": "从颗粒度来看，",
      "highlight": ""
    },
    {
      "from": 16447,
      "duration": 120,
      "text": "锁分为表级锁和 InnoDB 最核心的行级锁：",
      "highlight": "行级锁"
    },
    {
      "from": 16567,
      "duration": 99,
      "text": "改商品 A 时只锁住商品 A 这一条，",
      "highlight": ""
    },
    {
      "from": 16666,
      "duration": 78,
      "text": "买商品 B 的人完全不受影响。",
      "highlight": ""
    },
    {
      "from": 16750,
      "duration": 94,
      "text": "按读写权限又分共享锁和排他锁：",
      "highlight": ""
    },
    {
      "from": 16844,
      "duration": 94,
      "text": "共享锁允许大家一起读但不准改，",
      "highlight": ""
    },
    {
      "from": 16938,
      "duration": 118,
      "text": "排他锁则是修改数据时独占排斥其他读写。",
      "highlight": ""
    },
    {
      "from": 17065,
      "duration": 123,
      "text": "在 InnoDB 内部，行锁其实细分成了三副面孔：",
      "highlight": ""
    },
    {
      "from": 17188,
      "duration": 103,
      "text": "第一种是 Record Lock 记录锁，",
      "highlight": ""
    },
    {
      "from": 17291,
      "duration": 123,
      "text": "精准锁住单条索引记录，比如秒杀时只锁住某一件商品；",
      "highlight": ""
    },
    {
      "from": 17414,
      "duration": 88,
      "text": "第二种是 Gap Lock 间隙锁，",
      "highlight": "Gap Lock 间隙锁"
    },
    {
      "from": 17502,
      "duration": 128,
      "text": "在默认可重复读级别下，它会把两条记录之间的空隙锁住，",
      "highlight": ""
    },
    {
      "from": 17630,
      "duration": 113,
      "text": "防止别的事务中途插队新记录，专门用来堵死幻读；",
      "highlight": ""
    },
    {
      "from": 17743,
      "duration": 113,
      "text": "第三种叫 Next-Key Lock 临键锁，",
      "highlight": ""
    },
    {
      "from": 17856,
      "duration": 69,
      "text": "就是记录锁加上间隙锁的合体，",
      "highlight": ""
    },
    {
      "from": 17925,
      "duration": 97,
      "text": "它是 InnoDB 默认加锁的基本单位。",
      "highlight": ""
    },
    {
      "from": 18031,
      "duration": 85,
      "text": "最后必须记住两个线上血泪大坑！",
      "highlight": ""
    },
    {
      "from": 18122,
      "duration": 113,
      "text": "第一，InnoDB 的行锁其实是加在索引上的！",
      "highlight": "加在索引上的"
    },
    {
      "from": 18241,
      "duration": 90,
      "text": "如果你写了一条 UPDATE 语句，",
      "highlight": ""
    },
    {
      "from": 18331,
      "duration": 70,
      "text": "WHERE 条件却没走索引，",
      "highlight": ""
    },
    {
      "from": 18401,
      "duration": 120,
      "text": "InnoDB 被迫全表扫描给每一条记录都锁一遍，",
      "highlight": ""
    },
    {
      "from": 18521,
      "duration": 111,
      "text": "效果等同于整张表直接锁死，线上接口瞬间雪崩！",
      "highlight": ""
    },
    {
      "from": 18638,
      "duration": 127,
      "text": "第二是死锁：事务一锁着订单 A，去等库存 B，",
      "highlight": ""
    },
    {
      "from": 18765,
      "duration": 144,
      "text": "事务二同时锁着库存 B，去等订单 A，两人互相死等。",
      "highlight": ""
    },
    {
      "from": 18915,
      "duration": 148,
      "text": "虽然 InnoDB 会自动检测并回滚代价较小的一方，",
      "highlight": ""
    },
    {
      "from": 19063,
      "duration": 97,
      "text": "但写代码时只要统一按固定顺序加锁，",
      "highlight": ""
    },
    {
      "from": 19160,
      "duration": 143,
      "text": "并且把事务尽量拆短快提交，就能从根源把死锁消灭掉！",
      "highlight": ""
    },
    {
      "from": 19335,
      "duration": 88,
      "text": "还有一个高频疑问：磁盘读写那么慢，",
      "highlight": ""
    },
    {
      "from": 19423,
      "duration": 166,
      "text": "为什么平时执行 UPDATE 修改一条数据感觉瞬间就返回成功了？",
      "highlight": ""
    },
    {
      "from": 19595,
      "duration": 143,
      "text": "因为 InnoDB 在内存里划出了一块巨大的 Buffer Pool 缓冲池。",
      "highlight": "Buffer Pool"
    },
    {
      "from": 19744,
      "duration": 93,
      "text": "读数据时先把磁盘页载入缓冲池，",
      "highlight": ""
    },
    {
      "from": 19837,
      "duration": 137,
      "text": "改数据时也只先改内存页，不用立刻去随机刷盘。",
      "highlight": ""
    },
    {
      "from": 19980,
      "duration": 93,
      "text": "那万一改完内存还没刷盘就断电了怎么办？",
      "highlight": ""
    },
    {
      "from": 20079,
      "duration": 124,
      "text": "靠的就是经典的 WAL 机制，先写日志再刷盘：",
      "highlight": ""
    },
    {
      "from": 20203,
      "duration": 38,
      "text": "每次改完内存，",
      "highlight": ""
    },
    {
      "from": 20241,
      "duration": 168,
      "text": "立刻往磁盘末尾顺序追加一条极小的 Redo Log 重做日志，",
      "highlight": ""
    },
    {
      "from": 20409,
      "duration": 43,
      "text": "顺序写快如闪电，",
      "highlight": ""
    },
    {
      "from": 20452,
      "duration": 103,
      "text": "断电重启靠它重放就能把数据完好救回来！",
      "highlight": ""
    },
    {
      "from": 20564,
      "duration": 136,
      "text": "顺势把最容易混淆的 MySQL 三大日志一次彻底分清！",
      "highlight": "三大日志"
    },
    {
      "from": 20706,
      "duration": 87,
      "text": "第一，Redo Log 重做日志，",
      "highlight": ""
    },
    {
      "from": 20793,
      "duration": 71,
      "text": "属于 InnoDB 引擎层，",
      "highlight": ""
    },
    {
      "from": 20864,
      "duration": 107,
      "text": "记录数据页做了什么物理修改，循环覆盖写入，",
      "highlight": ""
    },
    {
      "from": 20971,
      "duration": 82,
      "text": "专门用来崩溃恢复保持久性；第二，",
      "highlight": ""
    },
    {
      "from": 21053,
      "duration": 71,
      "text": "Undo Log 回滚日志，",
      "highlight": ""
    },
    {
      "from": 21124,
      "duration": 133,
      "text": "也属于 InnoDB 引擎层，专门记修改之前的旧值，",
      "highlight": ""
    },
    {
      "from": 21257,
      "duration": 61,
      "text": "既负责事务失败一键回滚，",
      "highlight": ""
    },
    {
      "from": 21318,
      "duration": 107,
      "text": "又串起版本链支撑 MVCC 快照读；第三，",
      "highlight": ""
    },
    {
      "from": 21425,
      "duration": 133,
      "text": "Binlog 归档日志，属于上层 Server 层，",
      "highlight": ""
    },
    {
      "from": 21558,
      "duration": 71,
      "text": "所有引擎通用且一直追加保留，",
      "highlight": ""
    },
    {
      "from": 21629,
      "duration": 154,
      "text": "它是主从复制读写分离以及误删表后按时间点恢复数据的救命稻草！",
      "highlight": ""
    },
    {
      "from": 21792,
      "duration": 140,
      "text": "既然改一次数据要同时写 Redo Log 和 Binlog，",
      "highlight": ""
    },
    {
      "from": 21932,
      "duration": 51,
      "text": "万一刚写完一个就断电，",
      "highlight": ""
    },
    {
      "from": 21983,
      "duration": 93,
      "text": "主库和从库岂不是一边有数据、一边没数据？",
      "highlight": ""
    },
    {
      "from": 22082,
      "duration": 80,
      "text": "MySQL 用极其巧妙的两阶段提交来兜底：",
      "highlight": "两阶段提交"
    },
    {
      "from": 22162,
      "duration": 107,
      "text": "先把 Redo Log 写成 Prepare 预备状态，",
      "highlight": ""
    },
    {
      "from": 22269,
      "duration": 61,
      "text": "再去把 Binlog 稳稳落盘，",
      "highlight": ""
    },
    {
      "from": 22330,
      "duration": 111,
      "text": "最后才把 Redo Log 改成 Commit 正式提交。",
      "highlight": ""
    },
    {
      "from": 22447,
      "duration": 68,
      "text": "哪怕中途任意一步断电，",
      "highlight": ""
    },
    {
      "from": 22515,
      "duration": 99,
      "text": "重启时只要拿两份日志互相一核对，",
      "highlight": ""
    },
    {
      "from": 22614,
      "duration": 112,
      "text": "就能确保主从与崩溃恢复永远严丝合缝！",
      "highlight": ""
    },
    {
      "from": 22758,
      "duration": 69,
      "text": "把今天这七大块拼成一张全景图，",
      "highlight": "全景图"
    },
    {
      "from": 22827,
      "duration": 69,
      "text": "整座 MySQL 瞬间透明了：",
      "highlight": ""
    },
    {
      "from": 22896,
      "duration": 120,
      "text": "上层 Server 层负责连接、解析与优化器选路线；",
      "highlight": ""
    },
    {
      "from": 23016,
      "duration": 162,
      "text": "底层主力引擎 InnoDB 用三层 B+Tree 索引实现千万级秒查，",
      "highlight": ""
    },
    {
      "from": 23178,
      "duration": 176,
      "text": "用 Buffer Pool 搭配 Redo Log 兼顾极速写入与断电不丢，",
      "highlight": ""
    },
    {
      "from": 23354,
      "duration": 171,
      "text": "用 Undo Log 与 Read View 实现读写不阻塞的 MVCC，",
      "highlight": ""
    },
    {
      "from": 23525,
      "duration": 69,
      "text": "用行锁和间隙锁守住并发写安全，",
      "highlight": ""
    },
    {
      "from": 23594,
      "duration": 182,
      "text": "再借由 Server 层的 Binlog 和两阶段提交支撑主从复制与灾难恢复！",
      "highlight": ""
    },
    {
      "from": 23785,
      "duration": 160,
      "text": "送你四句线上防身口诀：查询先看执行计划守最左前缀，",
      "highlight": ""
    },
    {
      "from": 23945,
      "duration": 90,
      "text": "更新必走索引，谨防整表锁死，",
      "highlight": "更新必走索引"
    },
    {
      "from": 24035,
      "duration": 90,
      "text": "并发读写靠快照、写写靠行锁，",
      "highlight": ""
    },
    {
      "from": 24125,
      "duration": 82,
      "text": "事务短小顺序加锁远离死锁！",
      "highlight": ""
    },
    {
      "from": 24216,
      "duration": 84,
      "text": "这期干货满满建议先点赞收藏，",
      "highlight": ""
    },
    {
      "from": 24300,
      "duration": 138,
      "text": "以后遇到慢查询、锁表和主从问题随时翻出来对照，",
      "highlight": ""
    },
    {
      "from": 24438,
      "duration": 156,
      "text": "愿你的数据库永远零慢查、零死锁，小牛马准点打卡下班！",
      "highlight": "零慢查、零死锁"
    }
  ]
}
