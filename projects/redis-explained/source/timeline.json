      "from": 7951,
      "duration": 121,
      "text": "到点集体失效，或者 Redis 节点整体宕机，",
      "highlight": ""
    },
    {
      "from": 8072,
      "duration": 48,
      "text": "流量瞬间压垮后端。",
      "highlight": ""
    },
    {
      "from": 8126,
      "duration": 117,
      "text": "解药是给过期时间加上随机抖动打散高峰，",
      "highlight": ""
    },
    {
      "from": 8243,
      "duration": 99,
      "text": "并配合高可用集群和接口限流降级！",
      "highlight": ""
    },
    {
      "from": 8374,
      "duration": 128,
      "text": "内存毕竟寸土寸金，Redis 内存快撑满时怎么办？",
      "highlight": ""
    },
    {
      "from": 8508,
      "duration": 113,
      "text": "一方面，给 Key 设置 TTL 过期时间后，",
      "highlight": ""
    },
    {
      "from": 8621,
      "duration": 113,
      "text": "Redis 会用惰性删除配合定期删除悄悄清理；",
      "highlight": ""
    },
    {
      "from": 8734,
      "duration": 25,
      "text": "另一方面，",
      "highlight": ""
    },
    {
      "from": 8759,
      "duration": 137,
      "text": "内存触及 maxmemory 上限时会自动触发淘汰策略，",
      "highlight": ""
    },
    {
      "from": 8896,
      "duration": 172,
      "text": "生产中最常用的是 allkeys-lru 或 allkeys-lfu，",
      "highlight": "allkeys-lru"
    },
    {
      "from": 9068,
      "duration": 98,
      "text": "优先把最久没用或访问最少的冷数据请出去。",
      "highlight": ""
    },
    {
      "from": 9175,
      "duration": 64,
      "text": "想要单机不挂还能无限扩容，",
      "highlight": ""
    },
    {
      "from": 9239,
      "duration": 118,
      "text": "Redis 高可用有经典三件套：第一，主从复制，",
      "highlight": ""
    },
    {
      "from": 9357,
      "duration": 158,
      "text": "Master 主节点管写、Replica 从节点同步读并留备份；",
      "highlight": ""
    },
    {
      "from": 9515,
      "duration": 123,
      "text": "第二，Sentinel 哨兵模式，主节点一旦宕机，",
      "highlight": ""
    },
    {
      "from": 9638,
      "duration": 99,
      "text": "哨兵集群自动投票推举新主节点顶上；第三，",
      "highlight": ""
    },
    {
      "from": 9737,
      "duration": 94,
      "text": "Redis Cluster 集群分片，",
      "highlight": ""
    },
    {
      "from": 9831,
      "duration": 183,
      "text": "把数据按一万六千三百八十四个 Hash Slot 哈希槽切分到多台主节点，",
      "highlight": ""
    },
    {
      "from": 10014,
      "duration": 74,
      "text": "彻底突破单机内存和并发天花板！",
      "highlight": ""
    },
    {
      "from": 10120,
      "duration": 68,
      "text": "把今天的核心要点串起来，",
      "highlight": ""
    },
    {
      "from": 10188,
      "duration": 91,
      "text": "整座 Redis 架构一目了然：",
      "highlight": ""
    },
    {
      "from": 10279,
      "duration": 74,
      "text": "五大数据结构覆盖高频业务，",
      "highlight": ""
    },
    {
      "from": 10353,
      "duration": 141,
      "text": "纯内存、单线程核心和 epoll 飙出十万级吞吐，",
      "highlight": ""
    },
    {
      "from": 10494,
      "duration": 125,
      "text": "RDB 与 AOF 混合持久化兜底数据安全，",
      "highlight": ""
    },
    {
      "from": 10619,
      "duration": 113,
      "text": "布隆过滤、互斥锁和随机过期守住缓存防线，",
      "highlight": ""
    },
    {
      "from": 10732,
      "duration": 169,
      "text": "最后用哨兵和一万六千三百八十四个哈希槽实现高可用与水平扩展！",
      "highlight": ""
    },
    {
      "from": 10910,
      "duration": 151,
      "text": "记住这句口诀一辈子忘不掉：纯内存多结构扛高并发，",
      "highlight": ""
    },
    {
      "from": 11061,
      "duration": 120,
      "text": "快照加日志保数据不丢，防穿防击防雪崩，",
      "highlight": "防穿防击防雪崩"
    },
    {
      "from": 11181,
      "duration": 57,
      "text": "哨兵分片稳如泰山！",
      "highlight": ""
    },
    {
      "from": 11247,
      "duration": 89,
      "text": "如果这期讲得透彻记得点赞收藏，",
      "highlight": ""
    },
    {
      "from": 11336,
      "duration": 148,
      "text": "愿你的接口响应全是零点几毫秒，小牛马准点打卡下班！",
      "highlight": "零点几毫秒"
    }
  ]
}
