{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": ["es2015"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true
  },
  "include": [
    "tools/**/*.ts",
    "tools/**/*.tsx",
    "projects/*/source/**/*.ts",
    "projects/*/source/**/*.tsx",
    "remotion.config.ts"
  ]
}
